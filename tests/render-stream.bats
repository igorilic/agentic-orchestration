#!/usr/bin/env bats

# SDK-1 Step B-1: port the de-risked spike renderer to lib/render-stream.sh.
#
# Verifies that piping a committed fixture sentinel stream into
# `bash lib/render-stream.sh --plain` produces output that is BYTE-IDENTICAL
# to a committed golden file. The fixture exercises all six sentinel event
# types (phase/step/deleg/deleg_reject/verdict/done) and the spike's two
# crux regression cases documented in spikes/sdk-1-renderer/FINDINGS.md:
#   - an embedded `|` inside a two-field `step|ok` free-text field (must
#     render the full text intact — f2 = "everything after the first
#     remaining |" safely handles this);
#   - an embedded `|` inside a single-field `done` event (the bug the spike
#     found and fixed: f1/f2 truncate/drop content the moment the text
#     contains a "|"; the fix captures the raw post-evtype `rest` instead).
#
# The golden (tests/fixtures/sdk-1/basic.golden) was generated by running
# the UNMODIFIED spike renderer (spikes/sdk-1-renderer/render.sh --plain)
# over the fixture — since B-1 is a behavior-preserving port (no mechanic
# changes), the ported renderer's --plain output must match it exactly.
#
# Hermetic: the renderer only reads stdin / writes stdout, no filesystem or
# network side effects, no ~/.claude or ~/.copilot writes.

RENDERER="$BATS_TEST_DIRNAME/../lib/render-stream.sh"
FIXTURE="$BATS_TEST_DIRNAME/fixtures/sdk-1/basic.sentinels"
GOLDEN="$BATS_TEST_DIRNAME/fixtures/sdk-1/basic.golden"

setup() {
  TMP_OUT="$(mktemp)"
}

teardown() {
  rm -f "$TMP_OUT"
}

@test "render-stream --plain: exits 0 on the basic fixture" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  status=$?
  [ "$status" -eq 0 ]
}

@test "render-stream --plain: output is byte-identical to the committed golden" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  diff "$TMP_OUT" "$GOLDEN"
}

@test "render-stream --plain: embedded | in a two-field step|ok free-text renders intact" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  grep -qF "  ⏺ Compare A | B values | and C" "$TMP_OUT"
}

@test "render-stream --plain: embedded | in a single-field done event renders intact" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  grep -qF "✓ All done | finished" "$TMP_OUT"
}

@test "render-stream --plain: exercises all six sentinel event types" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  grep -qF "▸ tdd-developer · Sonnet" "$TMP_OUT"          # phase
  grep -qF "⏺ Fixing build error" "$TMP_OUT"               # step|ok
  grep -qF "✗ Retry implementation — build error" "$TMP_OUT"  # step|fail
  grep -qF "↳ sidekick · Haiku:" "$TMP_OUT"                # deleg
  grep -qF "❌ sidekick · Haiku:" "$TMP_OUT"                # deleg_reject
  grep -qF "verdict: GREEN (94)" "$TMP_OUT"                # verdict
  grep -qF "✓ All done | finished" "$TMP_OUT"              # done
}
