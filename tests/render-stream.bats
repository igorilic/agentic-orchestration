#!/usr/bin/env bats

# SDK-1 Step B-1: port the de-risked spike renderer to lib/render-stream.sh.
#
# Verifies that piping a committed fixture sentinel stream into
# `bash lib/render-stream.sh --plain` produces output that is BYTE-IDENTICAL
# to a committed golden file. The fixture exercises all six sentinel event
# types (phase/step/deleg/deleg_reject/verdict/done) and the spike's two
# crux regression cases documented in spikes/sdk-1-renderer/FINDINGS.md:
#   - an embedded `|` inside a two-field `step|ok` free-text field (must
#     render the full text intact — f2 = "everything after the first
#     remaining |" safely handles this);
#   - an embedded `|` inside a single-field `done` event (the bug the spike
#     found and fixed: f1/f2 truncate/drop content the moment the text
#     contains a "|"; the fix captures the raw post-evtype `rest` instead).
#
# The golden (tests/fixtures/sdk-1/basic.golden) was generated by running
# the UNMODIFIED spike renderer (spikes/sdk-1-renderer/render.sh --plain)
# over the fixture — since B-1 is a behavior-preserving port (no mechanic
# changes), the ported renderer's --plain output must match it exactly.
#
# Hermetic: the renderer only reads stdin / writes stdout, no filesystem or
# network side effects, no ~/.claude or ~/.copilot writes.

RENDERER="$BATS_TEST_DIRNAME/../lib/render-stream.sh"
FIXTURE="$BATS_TEST_DIRNAME/fixtures/sdk-1/basic.sentinels"
GOLDEN="$BATS_TEST_DIRNAME/fixtures/sdk-1/basic.golden"
MALFORMED="$BATS_TEST_DIRNAME/fixtures/sdk-1/malformed.sentinels"
DELEG_FIXTURE="$BATS_TEST_DIRNAME/fixtures/sdk-1/delegation.sentinels"
MILESTONES_LOG=".anw/specs/SDK-1-milestones.jsonl"

setup() {
  TMP_OUT="$(mktemp "$BATS_TMPDIR/tmp.XXXXXX")"
}

teardown() {
  rm -f "$TMP_OUT"
  # SDK-1 Step B-4: only the milestone-persistence tests below set SANDBOX
  # (via run_deleg_render) — clean it up here so every other test's
  # setup/teardown stays untouched.
  if [ -n "${SANDBOX:-}" ]; then
    cd "$BATS_TEST_DIRNAME" || true
    rm -rf "$SANDBOX"
    unset SANDBOX
  fi
}

# SDK-1 Step B-4: runs the renderer over delegation.sentinels with the
# orchestrator-injected identity env, inside a throwaway sandbox cwd (mirrors
# tests/milestones.bats) so the writer's relative .anw/specs/ path never
# touches the real project tree. Leaves cwd IN the sandbox so callers can
# read $MILESTONES_LOG with a relative path; teardown() cds back out.
run_deleg_render() {
  SANDBOX="$(mktemp -d "${TMPDIR:-/tmp}/aw-render-milestones-XXXXXX")"
  cd "$SANDBOX"
  AW_SPEC_ID=SDK-1 AW_PIPELINE_STEP=4.2 AW_AGENT=tdd-developer AW_TIER=sonnet \
    bash "$RENDERER" --plain < "$DELEG_FIXTURE" > "$TMP_OUT"
}

@test "render-stream --plain: exits 0 on the basic fixture" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  status=$?
  [ "$status" -eq 0 ]
}

@test "render-stream --plain: output is byte-identical to the committed golden" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  diff "$TMP_OUT" "$GOLDEN"
}

@test "render-stream --plain: embedded | in a two-field step|ok free-text renders intact" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  grep -qF "  ⏺ Compare A | B values | and C" "$TMP_OUT"
}

@test "render-stream --plain: embedded | in a single-field done event renders intact" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  grep -qF "✓ All done | finished" "$TMP_OUT"
}

@test "render-stream --plain: exercises all six sentinel event types" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  grep -qF "▸ tdd-developer · Sonnet" "$TMP_OUT"          # phase
  grep -qF "⏺ Fixing build error" "$TMP_OUT"               # step|ok
  grep -qF "✗ Retry implementation — build error" "$TMP_OUT"  # step|fail
  grep -qF "↳ sidekick · Haiku:" "$TMP_OUT"                # deleg
  grep -qF "❌ sidekick · Haiku:" "$TMP_OUT"                # deleg_reject
  grep -qF "verdict: GREEN (94)" "$TMP_OUT"                # verdict
  grep -qF "✓ All done | finished" "$TMP_OUT"              # done
}

# ---------------------------------------------------------------------------
# SDK-1 Step B-2: arity validation (OQ-1 hardening).
#
# The production renderer must DROP malformed / arity-short sentinel lines
# instead of mis-rendering them (spike gap #1, spikes/sdk-1-renderer/FINDINGS.md
# "Left as-is" item 1: "@@ANW|step|run" with no text field silently rendered
# as "⏺ run" — the status keyword mis-displayed as the milestone text). Per
# spec OQ-1's "Arity validation" decision: unknown event types and any known
# event missing its required field(s) (phase=2, step=2, deleg=2,
# deleg_reject=2, verdict=2, done=1 free-text) are dropped, not rendered.
# Dropping is line-local — a valid line elsewhere in the same stream must
# still render, and no malformed input may crash the renderer.
#
# tests/fixtures/sdk-1/malformed.sentinels uses the LITERAL "@@ANW|" prefix
# (renderer input, not agent-visible prose) and interleaves one valid line
# among 8 malformed ones covering every case below.
# ---------------------------------------------------------------------------

@test "render-stream --plain: step|run with no text field is not rendered as a status keyword" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "run" "$TMP_OUT"
}

@test "render-stream --plain: step with an out-of-enum status is dropped" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "Some malformed status text" "$TMP_OUT"
  ! grep -qF "pending" "$TMP_OUT"
}

@test "render-stream --plain: unknown event type is dropped" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "bogus" "$TMP_OUT"
  ! grep -qF "x" "$TMP_OUT"
}

@test "render-stream --plain: phase missing its tier field is dropped" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "▸" "$TMP_OUT"
  ! grep -qF "architect" "$TMP_OUT"
}

@test "render-stream --plain: deleg missing its text field is dropped" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "↳" "$TMP_OUT"
}

@test "render-stream --plain: deleg_reject missing its text field is dropped" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "❌" "$TMP_OUT"
}

@test "render-stream --plain: verdict missing its score field is dropped" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "verdict:" "$TMP_OUT"
}

@test "render-stream --plain: done missing its text field is dropped" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  ! grep -qF "✓" "$TMP_OUT"
}

@test "render-stream --plain: a valid line interleaved among malformed ones still renders (dropping is line-local)" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  grep -qF "  ⏺ Valid step renders fine" "$TMP_OUT"
}

@test "render-stream --plain: malformed stream renders ONLY the one valid line" {
  bash "$RENDERER" --plain < "$MALFORMED" > "$TMP_OUT"
  [ "$(cat "$TMP_OUT")" = "  ⏺ Valid step renders fine" ]
}

@test "render-stream --plain: an all-malformed stream does not crash and exits 0" {
  run bash -c "grep -v 'Valid step renders fine' '$MALFORMED' | bash '$RENDERER' --plain"
  [ "$status" -eq 0 ]
}

@test "render-stream --plain: B-1 golden regression is unaffected by arity validation" {
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  diff "$TMP_OUT" "$GOLDEN"
}

# ---------------------------------------------------------------------------
# SDK-1 Step B-4: renderer persists milestones as each sentinel is finalized.
#
# lib/render-stream.sh sources lib/milestones.sh and calls append_milestone
# for each well-formed event, injecting spec_id/pipeline_step/agent/tier from
# the orchestrator env (identity is authoritative from env, per spec OQ-2 —
# not re-derived from the phase sentinel's own agent/tier fields). B-2's
# arity validation already dropped malformed lines before they reach a
# finalize point, so no milestone is ever written for a dropped line.
# ---------------------------------------------------------------------------

@test "render-stream --plain: persists milestones with orchestrator-injected spec_id/pipeline_step/agent/tier" {
  run_deleg_render
  [ -f "$MILESTONES_LOG" ]
  [ "$(jq -r '.spec_id' "$MILESTONES_LOG" | sort -u)" = "SDK-1" ]
  [ "$(jq -r '.pipeline_step' "$MILESTONES_LOG" | sort -u)" = "4.2" ]
  [ "$(jq -r '.agent' "$MILESTONES_LOG" | sort -u)" = "tdd-developer" ]
  [ "$(jq -r '.tier' "$MILESTONES_LOG" | sort -u)" = "sonnet" ]
}

@test "render-stream --plain: deleg milestone carries event=deleg, delegated_to=haiku, parent_text=the active parent step's text" {
  run_deleg_render
  [ "$(jq -r 'select(.event=="deleg") | .delegated_to' "$MILESTONES_LOG")" = "haiku" ]
  [ "$(jq -r 'select(.event=="deleg") | .text' "$MILESTONES_LOG")" = "Generated class stubs" ]
  [ "$(jq -r 'select(.event=="deleg") | .parent_text' "$MILESTONES_LOG")" = "Implementing feature" ]
}

@test "render-stream --plain: step milestone carries its status" {
  run_deleg_render
  [ "$(jq -r 'select(.event=="step") | .status' "$MILESTONES_LOG")" = "run" ]
  [ "$(jq -r 'select(.event=="step") | .text' "$MILESTONES_LOG")" = "Implementing feature" ]
}

@test "render-stream --plain: no milestones written when AW_SPEC_ID is unset (B-1/B-2 tests stay side-effect-free)" {
  SANDBOX="$(mktemp -d "${TMPDIR:-/tmp}/aw-render-milestones-XXXXXX")"
  cd "$SANDBOX"
  bash "$RENDERER" --plain < "$FIXTURE" > "$TMP_OUT"
  [ ! -d ".anw" ]
}

# ---------------------------------------------------------------------------
# SDK-1 Step B-7 close-out (F1): idle heartbeat.
#
# render_active() used to return immediately when ACTIVE_TEXT was empty, so
# any stretch of the stream with no active `step|run` (e.g. the entire
# `troubleshooter` pipeline, which emits no sentinels at all, or plain
# per-agent startup latency) left the TTY screen blank -- no proof the
# renderer, or the agent, is even alive. B-7 removed the old generic
# `spinner_start`/`spinner_stop` (AC-7), so nothing else fills that gap.
#
# Fix: when no ACTIVE_TEXT is set, render_active() draws an idle heartbeat
# line instead ("<spinner> ▸ <AW_AGENT> · <AW_TIER> (<elapsed>)"), using a
# STREAM_START epoch captured once at script start. TTY-only -- --plain /
# non-TTY stays silent, unaffected (asserted above; the plain path never
# calls render_active() at all).
#
# First exercise of the --force-tty path in this suite (previously
# untested): --force-tty makes IS_TTY=true without a real terminal, so the
# TTY FIFO/ticker loop runs under bats. The fixture below feeds NO sentinel
# lines at all -- input closes only after a short delay -- so ACTIVE_TEXT
# never becomes non-empty and at least one 0.2s ticker frame fires before
# EOF. Timing-tolerant: 0.6s gives ~3 ticker frames of margin over the one
# frame actually needed.
# ---------------------------------------------------------------------------

@test "render-stream --force-tty: idle heartbeat renders when no sentinel is ever active (screen never blank)" {
  AW_AGENT=troubleshooter AW_TIER=opus \
    bash "$RENDERER" --force-tty < <(sleep 0.6) > "$TMP_OUT" 2>&1
  grep -qF "troubleshooter" "$TMP_OUT"
  grep -qF "opus" "$TMP_OUT"
}

@test "render-stream --force-tty: idle heartbeat renders before a delayed first sentinel, then the active line takes over" {
  bash "$RENDERER" --force-tty \
    < <(sleep 0.6; printf '@@ANW|step|run|Investigating incident\n'; sleep 0.3) \
    > "$TMP_OUT" 2>&1
  grep -qF "▸" "$TMP_OUT"
  grep -qF "Investigating incident" "$TMP_OUT"
}
